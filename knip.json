{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "@ant/*",
    "react-compiler-runtime",
    "chrome-devtools-mcp",
    "undici"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/entrypoints/cli.tsx",
        "build.ts",
        "vite.config.ts",
        "scripts/**/*.{ts,mjs,cjs}",
        "src/**/*.runner.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/types/**"]
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/@ant/*": {
      "ignore": ["**"]
    }
  }
}
