{
  "name": "@open-claude-code/remote-control-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:web && bun run --watch src/index.ts",
    "dev:web": "cd web && bunx vite",
